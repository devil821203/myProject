{
  "manifest_version": 3,
  "name": "YouTube Auto Ad Skipper",
  "version": "3.2.0",
  "description": "使用頁面偵測搭配短暫 Chrome DevTools Protocol 點擊，自動略過 YouTube 廣告；避免長時間顯示偵錯提示。",
  "permissions": [
    "storage",
    "tabs",
    "debugger"
  ],
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "action": {
    "default_title": "YouTube Auto Ad Skipper",
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content_script/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
