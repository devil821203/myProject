{
  "manifest_version": 3,
  "name": "YouTube Auto Ad Skipper",
  "version": "3.3.0",
  "description": "以事件驅動 Content Script 搭配短暫 CDP 點擊，自動略過前景或背景 YouTube 分頁中的可略過廣告。",
  "permissions": [
    "storage",
    "tabs",
    "debugger"
  ],
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "action": {
    "default_title": "YouTube Auto Ad Skipper",
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content_script/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
